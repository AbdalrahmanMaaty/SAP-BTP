projection;
//strict ( 2 ); //Uncomment this line in order to enable strict mode 2. The strict mode has two variants (strict(1), strict(2)) and is prerequisite to be future proof regarding syntax and to be able to release your BO.
use draft;

define behavior for ZC_TRIP_HEAD alias TripHDR
{
  use create;
  use update;
  use delete;

  use association _TripITM { create; with draft; }
}

define behavior for ZC_TRIP_ITEM //alias <alias_name>
{
  use update;
  use delete;

  use association _TripHDR { with draft; }
}